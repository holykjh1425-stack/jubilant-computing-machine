[Unit]
Description=NEXUS single approved agent task
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nexus
WorkingDirectory=/opt/nexus
EnvironmentFile=/etc/nexus/production.env
ExecStart=/usr/bin/node /opt/nexus/ops/production-runner.mjs ${NEXUS_PROVIDER}
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/nexus
TimeoutStartSec=180
# Install CLI and authorize its existing subscription on the private host separately.
# Never copy ChatGPT session files, API keys or controller keys into this repository.
