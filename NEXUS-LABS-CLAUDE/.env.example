# Documentation only. This application does NOT read .env files.
# Inject API keys using an OS/hosting secret manager. Never populate this tracked file.
NEXUS_LIVE_ENABLED=false
NEXUS_PRICING_VERIFIED=false
NEXUS_MONTHLY_MICRO_USD=0
NEXUS_JOB_MICRO_USD=0
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Positive integer micro-USD per token; round UP from verified model pricing.
OPENAI_INPUT_MICRO_USD_PER_TOKEN=0
OPENAI_OUTPUT_MICRO_USD_PER_TOKEN=0
ANTHROPIC_INPUT_MICRO_USD_PER_TOKEN=0
ANTHROPIC_OUTPUT_MICRO_USD_PER_TOKEN=0
